# Azure AI Vision Service Configuration
# Replace the placeholder values with your actual Azure credentials
 
# Your Azure AI Services endpoint (e.g., https://your-resource-name.cognitiveservices.azure.com/)
AI_SERVICE_ENDPOINT=your_azure_ai_services_endpoint

# Your Azure AI Services key (found in Azure Portal under Keys and Endpoint)
AI_SERVICE_KEY=your_azure_ai_services_key

# IMPORTANT: 
# 1. Never commit this file to GitHub if it contains real credentials
# 2. Add .env to your .gitignore file
# 3. Get your credentials from Azure Portal:
#    - Go to your Azure AI Services resource
#    - Navigate to "Keys and Endpoint" section
#    - Copy Endpoint and Key 1 (or Key 2)
